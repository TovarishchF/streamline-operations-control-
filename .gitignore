# Секреты — в репозиторий не попадают (CLAUDE.md § 3 п. 8)
.env
.env.*
!.env.example
*.pem
*.key
!deploy/**/*.key.example

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/

# Кэш загрузок scripts/build_reference.py: исходные наборы открытых данных,
# результат сборки лежит в shared/reference/ и в репозиторий попадает он.
.cache/

# Ссылки otpauth демонстрационного стенда: учётные данные вымышленных
# пользователей, но в репозитории им всё равно не место (CLAUDE.md § 3 п. 8).
artifacts/demo-2fa.json
.coverage
coverage.xml
htmlcov/

# Node
node_modules/
dist/
.vite/
*.tsbuildinfo

# Сгенерированное из контракта — генерируется make api-types
shared/api-types.ts

# Локальные данные
*.sqlite3
media/
staticfiles/

# Артефакты испытаний: складываются осознанно, мусор — нет
artifacts/**/tmp/
artifacts/**/*.raw

# Редакторы и ОС
.idea/
.vscode/
.DS_Store
Thumbs.db

# Схема, генерируемая из кода для сверки с контрактом
artifacts/openapi.generated.yaml

# Результаты прогонов Playwright: отчёт и трассировки пересоздаются
e2e/test-results/
artifacts/e2e/report/
