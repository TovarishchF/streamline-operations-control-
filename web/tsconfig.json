{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "types": ["vite/client", "vitest/globals", "node"],

    "strict": true,
    "noImplicitAny": true,
    "noUncheckedIndexedAccess": true,

    // exactOptionalPropertyTypes намеренно выключен: в strict он не входит,
    // а сгенерированные из openapi.yaml типы и пропсы Ant Design объявляют
    // необязательные поля как `prop?: T`, что с ним несовместимо. Требование
    // CLAUDE.md § 3 п. 15 — strict и запрет any — выполняется.
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,

    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": false,
    "skipLibCheck": true,
    "noEmit": true,

    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@shared/*": ["../shared/*"]
    }
  },
  "include": ["src", "vite.config.ts"]
}
