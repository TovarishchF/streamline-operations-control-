# Окружение установки для показа. Файл .env из этого шаблона создаёт
# deploy/sample/install.sh: значения в двойных фигурных скобках он
# подставляет сам, пароли и ключи генерирует случайными.

DJANGO_SETTINGS_MODULE=config.settings.prod
SECRET_KEY={{SECRET_KEY}}
ALLOWED_HOSTS={{HOST}},localhost,127.0.0.1
# Сервер без сертификата работает по HTTP. С сертификатом — true.
HTTPS_ONLY=false
LOG_LEVEL=INFO
RELEASE_VERSION={{VERSION}}

# Порт веб-клиента на сервере и порт просмотра исходящей почты (только с сервера).
HTTP_PORT={{PORT}}
MAIL_UI_PORT=8025

POSTGRES_DB=soc
POSTGRES_USER=soc
POSTGRES_PASSWORD={{DB_PASSWORD}}
DATABASE_URL=postgres://soc:{{DB_PASSWORD}}@db:5432/soc
REDIS_URL=redis://redis:6379/0

S3_ENDPOINT=http://minio:9000
S3_PUBLIC_ENDPOINT={{PUBLIC_URL}}
S3_BUCKET=soc
S3_ACCESS_KEY=soc-storage
S3_SECRET_KEY={{S3_SECRET}}

# Данные генератора и вход без приложения-аутентификатора.
SAMPLE_DATA=true
LOGIN_ACCOUNT_LIST=true
TWO_FACTOR_REQUIRED_ROLES=

# Работающие подключения: курсы ЦБ РФ и исходящая почта (в Mailpit на сервере).
INTEGRATIONS_ENABLED=FX,SMTP
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM=soc@demo.test
SMTP_USE_TLS=false
