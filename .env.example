# ═══════════════════════════════════════════════════════════════════════════
# SOC — пример файла окружения
#
# Скопировать в .env и заполнить. В репозиторий .env не попадает
# (CLAUDE.md § 3 п. 8). Для on-premise — права 600, для облака — менеджер
# секретов провайдера.
#
# Перечень переменных — INFRA.md § 3.
# ═══════════════════════════════════════════════════════════════════════════

# ─────────────────────────── Основное ───────────────────────────

# config.settings.dev | config.settings.prod | config.settings.test
DJANGO_SETTINGS_MODULE=config.settings.dev

# Обязательно в проде. Запуск с незаполненным значением отклоняется (ADR-013).
SECRET_KEY=
DEBUG=false
ALLOWED_HOSTS=localhost,127.0.0.1
LOG_LEVEL=INFO
RELEASE_VERSION=
RELEASE_COMMIT=

# ─────────────────────────── Хранилища ───────────────────────────

# ADR-001: PostgreSQL — единственная СУБД. MSSQL не поддерживается.
DATABASE_URL=postgres://soc:soc@db:5432/soc

# Реплика только для чтения: отчёты и подключение Power BI / Tableau (ADR-005).
REPLICA_DATABASE_URL=

# Порт, на котором база видна с хоста (только для инструментов разработки).
# На Windows 5432 нередко занят зарезервированным диапазоном Hyper-V.
DB_HOST_PORT=15432

# Адрес базы для прогона тестов с машины разработчика: из контейнера база
# видна как db:5432, с хоста — на localhost и порту DB_HOST_PORT. Пусто —
# используется DATABASE_URL (так работает CI).
TEST_DATABASE_URL=

REDIS_URL=redis://redis:6379/0

# S3-совместимое хранилище вложений (ADR-007). Локально — MinIO.
S3_ENDPOINT=http://minio:9000
# Адрес, по которому к хранилищу обращается браузер: подписанная ссылка
# на загрузку выдаётся именно для него (подпись покрывает Host).
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_BUCKET=soc
S3_ACCESS_KEY=
S3_SECRET_KEY=

# ─────────────────────────── Генератор данных ───────────────────────────

# ADR-008. Включает генератор данных (`make seed-sample`, экран «Генератор
# данных» у администратора) и управление модельным временем. Записи
# генератора несут is_generated и удаляются `seed_sample --purge`, не задевая
# введённое людьми. В интерфейсе и выгрузках режим не обозначается.
# Режимы внешних подключений от него не зависят — они видны на /admin/integrations.
# В рабочей установке — только false.
SAMPLE_DATA=false
# Список учётных записей на экране входа. Паролей не содержит.
# В рабочей установке — только false.
LOGIN_ACCOUNT_LIST=false

# Роли, которым второй фактор обязателен. Пустое значение — не требовать
# ни от кого; привязать приложение по-прежнему может любой пользователь.
# На установке для показа оставляют пустым: у того, кто смотрит систему,
# может не быть приложения-аутентификатора.
TWO_FACTOR_REQUIRED_ROLES=admin,finance

# ═══════════════════════════════════════════════════════════════════════════
# ВНЕШНИЕ ПОДКЛЮЧЕНИЯ
#
# Заглушек нет (ADR-039): подключение либо работает с настоящей системой,
# либо выключено, и система его не вызывает. Работают подключения из списка
# ниже, для которых написан адаптер; сейчас это FX и SMTP. Как подключать
# каждое и что для этого нужно — docs/CONNECTING.md.
# ═══════════════════════════════════════════════════════════════════════════

INTEGRATIONS_ENABLED=FX,SMTP

# Курсы валют, ЦБ РФ. Открытый источник, ключ не нужен; серверу нужен
# исходящий HTTPS до www.cbr.ru (INTEGRATIONS § 2.1).

# Исходящая почта. В dev — Mailpit в контейнере: письма уходят по-настоящему,
# но наружу не выходят. В бою — сервер заказчика; на домене нужны SPF/DKIM/DMARC.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=false

# ─── Адаптеры ещё не написаны: что нужно от заказчика — docs/CONNECTING.md ───

# Разбор входящей почты. Нужен выделенный ящик и доступ по IMAP (§ 3.3).
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=

# Корпоративный мессенджер MAX. Наличие Bot API не подтверждено — G-04.
MSGR_BOT_TOKEN=
MSGR_DEFAULT_CHAT_ID=

# Active Directory (§ 4.1).
LDAP_SERVER_URI=
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=
LDAP_BASE_DN=

# 1С:Бухгалтерия через OData (§ 4.2).
ONEC_ODATA_URL=
ONEC_USER=
ONEC_PASSWORD=

# Электронный документооборот. В ТЗ отсутствует, внесён в GAPS.md (§ 4.3).
EDO_API_URL=
EDO_API_TOKEN=
EDO_CERT_THUMBPRINT=

# Данные о движении ВС. OpenSky не покрывает всю бизнес-авиацию (§ 2.3).
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# ─────────────────────────── Наблюдаемость ───────────────────────────

SENTRY_DSN=

# ─────────────────────────── Веб-клиент ───────────────────────────

VITE_API_BASE_URL=http://localhost:8000/api/v1
