# ═══════════════════════════════════════════════════════════════════════════
# SOC — пример файла окружения
#
# Скопировать в .env и заполнить. В репозиторий .env не попадает
# (CLAUDE.md § 3 п. 8). Для on-premise — права 600, для облака — менеджер
# секретов провайдера.
#
# Перечень переменных — INFRA.md § 3.
# ═══════════════════════════════════════════════════════════════════════════

# ─────────────────────────── Основное ───────────────────────────

# config.settings.dev | config.settings.prod | config.settings.test
DJANGO_SETTINGS_MODULE=config.settings.dev

# Обязательно в проде. Запуск с незаполненным значением отклоняется (ADR-013).
SECRET_KEY=
DEBUG=false
ALLOWED_HOSTS=localhost,127.0.0.1
LOG_LEVEL=INFO
RELEASE_VERSION=
RELEASE_COMMIT=

# ─────────────────────────── Хранилища ───────────────────────────

# ADR-001: PostgreSQL — единственная СУБД. MSSQL не поддерживается.
DATABASE_URL=postgres://soc:soc@db:5432/soc

# Реплика только для чтения: отчёты и подключение Power BI / Tableau (ADR-005).
REPLICA_DATABASE_URL=

# Порт, на котором база видна с хоста (только для инструментов разработки).
# На Windows 5432 нередко занят зарезервированным диапазоном Hyper-V.
DB_HOST_PORT=15432

REDIS_URL=redis://redis:6379/0

# S3-совместимое хранилище вложений (ADR-007). Локально — MinIO.
S3_ENDPOINT=http://minio:9000
S3_BUCKET=soc
S3_ACCESS_KEY=
S3_SECRET_KEY=

# ─────────────────────────── Режим демонстрации ───────────────────────────

# ADR-008. Включает: бейдж «ДЕМО-СТЕНД», водяной знак DEMO на выгрузках,
# префикс [DEMO] в темах писем, доступность команды seed_demo и управление
# модельным временем.
#
# ВАЖНО: режимы внешних подключений на эту маркировку НЕ влияют. Подключение
# в режиме stub не превращает боевой счёт в демонстрационный — фактический
# режим виден на /admin/integrations.
DEMO_DATA=false

# ═══════════════════════════════════════════════════════════════════════════
# ВНЕШНИЕ ПОДКЛЮЧЕНИЯ
#
# Каждое — адаптер с двумя режимами: live (настоящая система) и stub
# (детерминированные искусственные данные того же формата).
# Значение по умолчанию — stub: боевой режим включается осознанно.
# Доменный код разницы не видит (INTEGRATIONS.md § 1).
#
# Перевод в live = заполнить учётные данные ниже и сменить режим.
# Правок кода не требуется — это проверяется тестом.
# ═══════════════════════════════════════════════════════════════════════════

# ─── Доступны в live без участия заказчика: ключи и договоры не нужны ───

# Курсы валют, ЦБ РФ. Открытый источник (INTEGRATIONS § 2.1).
INTEGRATION_FX_MODE=stub

# METAR/TAF, Aviation Weather Center (NOAA). Открытый источник (§ 2.2).
INTEGRATION_WX_MODE=stub

# Справочник аэропортов, OurAirports. Загружается один раз в базу (§ 2.4).
INTEGRATION_APT_MODE=stub

# Реплика только для чтения и представления для BI (§ 4.4, ADR-005).
INTEGRATION_BI_MODE=stub

# ─── Требуют получения доступов от заказчика (письмо от 12.09.2026) ───

# Исходящая почта. Нужны: сервер, учётные данные, настройка SPF/DKIM/DMARC.
INTEGRATION_SMTP_MODE=stub
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Разбор входящей почты. Нужен выделенный ящик и доступ по IMAP (§ 3.3).
INTEGRATION_MAILBOT_MODE=stub
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=

# Корпоративный мессенджер MAX. Наличие Bot API не подтверждено — G-04.
INTEGRATION_MSGR_MODE=stub
MSGR_BOT_TOKEN=
MSGR_DEFAULT_CHAT_ID=

# Active Directory. В dev и на стенде поднимается OpenLDAP в контейнере,
# поэтому механизм проверяется по-настоящему до получения доступа к домену.
INTEGRATION_LDAP_MODE=stub
LDAP_SERVER_URI=
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=
LDAP_BASE_DN=

# 1С:Бухгалтерия через OData. Главный риск проекта после почтового робота:
# сроки без осмотра конфигурации оценке не поддаются (§ 4.2).
INTEGRATION_ONEC_MODE=stub
ONEC_ODATA_URL=
ONEC_USER=
ONEC_PASSWORD=

# Электронный документооборот. В ТЗ отсутствует, внесён в GAPS.md (§ 4.3).
INTEGRATION_EDO_MODE=stub
EDO_API_URL=
EDO_API_TOKEN=
EDO_CERT_THUMBPRINT=

# Данные о движении ВС. OpenSky не покрывает всю бизнес-авиацию (§ 2.3).
# Ручной ввод фактического времени остаётся основным для бортов без покрытия.
INTEGRATION_TRACK_MODE=stub
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# ─── Постоянно в stub: публичных подключений не существует (§ 5) ───

# Слот-координация: координаторы работают сообщениями IATA SSIM по почте.
# Реализуется реестр слотов и подготовка сообщений, а не интеграция.
INTEGRATION_SLOT_MODE=stub

# Системы поставщиков: у большинства FBO и топливных операторов API нет.
INTEGRATION_VENDOR_API_MODE=stub

# IATA SIS / IS-XML. Участие требует членства и сертификации — G-03.
INTEGRATION_IATA_MODE=stub

# ─────────────────────────── Наблюдаемость ───────────────────────────

SENTRY_DSN=

# ─────────────────────────── Веб-клиент ───────────────────────────

VITE_API_BASE_URL=http://localhost:8000/api/v1
